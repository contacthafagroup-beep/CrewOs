# ──────────────────────────────────────────────────────────────
# CrewOS environment. Copy to .env and fill in.
# The app BUILDS with none of these set. Runtime behavior
# degrades gracefully (mock AI, demo auth, console email).
# ──────────────────────────────────────────────────────────────

# ── Database (required at runtime) ────────────────────────────
# Free tier: https://neon.tech → copy the pooled connection string.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# ── Auth ──────────────────────────────────────────────────────
# Secret used to sign session JWTs. Generate: openssl rand -base64 32
AUTH_SECRET=""
# "true" once real auth providers are configured. When false/empty,
# the login page exposes one-click DEMO login (see DEMO_MODE).
AUTH_ENABLED=""
# Demo workspace login. Keep "true" locally, set "false" in production.
DEMO_MODE="true"
# Where auth links point. Defaults to the request origin when empty.
APP_URL=""

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Microsoft Entra ID OAuth (https://portal.azure.com → App registrations)
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# ── AI providers (any one enables real generation; priority order) ──
# Explicit provider override: openai | anthropic | gemini | ollama
AI_PROVIDER=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
OLLAMA_BASE_URL="http://localhost:11434"

# Optional model overrides per task tier (fast | balanced | premium)
CREWOS_MODEL_FAST=""
CREWOS_MODEL_BALANCED=""
CREWOS_MODEL_PREMIUM=""

# ── Stripe (billing) ─────────────────────────────────────────
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Create 6 recurring prices in Stripe (monthly + annual per plan),
# then paste their price_... ids here. Annual price = 10× monthly
# (2 months free), e.g. Starter: $199/mo or $1,990/yr.
STRIPE_PRICE_STARTER_MONTHLY=""
STRIPE_PRICE_STARTER_ANNUAL=""
STRIPE_PRICE_GROWTH_MONTHLY=""
STRIPE_PRICE_GROWTH_ANNUAL=""
STRIPE_PRICE_SCALE_MONTHLY=""
STRIPE_PRICE_SCALE_ANNUAL=""

# ── Email (transactional) ────────────────────────────────────
# Without a key, emails are logged to the server console.
RESEND_API_KEY=""
EMAIL_FROM="CrewOS <hello@yourdomain.com>"

# ── Worker ───────────────────────────────────────────────────
# Shared secret for POST /api/worker/tick (Vercel Cron / uptime pings).
WORKER_TOKEN=""
# When "true" (default in dev), agent runs execute inline instead of
# waiting for a worker tick. Set "false" in production + run a worker.
WORKER_INLINE="true"
