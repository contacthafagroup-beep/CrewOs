# CrewOS environment. Copy to .env and fill in.
# The app BUILDS with none of these set. Runtime behavior
# degrades gracefully (mock AI, demo auth, console email).

# ── Database (required at runtime) ────────────────────────────
# Free tier: https://neon.tech → copy the POOLED connection string.
DATABASE_URL="postgresql://user:***@host/db?sslmode=require"

# ── Auth ──────────────────────────────────────────────────────
# Secret used to sign session JWTs. Generate: openssl rand -base64 32
AUTH_SECRET=""
# "true" once real auth providers are configured. When false/empty,
# the login page exposes one-click DEMO login (see DEMO_MODE).
AUTH_ENABLED="true"
# Demo workspace login. Keep "true" locally, set "false" in production.
DEMO_MODE="true"
# Where auth links point (your Vercel URL or custom domain, no trailing slash).
APP_URL=""

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Redirect URI: {APP_URL}/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Microsoft Entra ID OAuth (https://portal.azure.com → App registrations)
# Redirect URI: {APP_URL}/api/auth/oauth/microsoft/callback
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# ── AI providers (any one enables real generation; priority order) ──
# Explicit provider override: openai | anthropic | gemini | ollama
AI_PROVIDER=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
OLLAMA_BASE_URL="http://localhost:11434"

# Model overrides per task tier (fast | balanced | premium).
# IMPORTANT: use CURRENT model ids — Google retires old ones for new keys
# (e.g. gemini-2.5-flash → 404 "no longer available to new users").
# Check https://ai.google.dev/gemini-api/docs/models for live ids.
# Verified working (2026-09): gemini-3.6-flash. gemini-3.1-pro exists but
# was capacity-saturated (503 high demand) at verification time.
CREWOS_MODEL_FAST="gemini-3.6-flash"
CREWOS_MODEL_BALANCED="gemini-3.6-flash"
CREWOS_MODEL_PREMIUM="gemini-3.1-pro"

# ── Stripe (billing) ─────────────────────────────────────────
# https://dashboard.stripe.com/apikeys  (test mode first!)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Create 6 recurring prices (monthly + annual per plan), annual = 10x monthly:
#   Starter $199 / $1,990 · Growth $499 / $4,990 · Scale $999 / $9,990
STRIPE_PRICE_STARTER_MONTHLY=""
STRIPE_PRICE_STARTER_ANNUAL=""
STRIPE_PRICE_GROWTH_MONTHLY=""
STRIPE_PRICE_GROWTH_ANNUAL=""
STRIPE_PRICE_SCALE_MONTHLY=""
STRIPE_PRICE_SCALE_ANNUAL=""

# ── Email (transactional) ────────────────────────────────────
# Without a key, emails log to the server console.
RESEND_API_KEY=""
EMAIL_FROM="CrewOS <hello@yourdomain.com>"

# ── Worker ───────────────────────────────────────────────────
# Shared secret for POST /api/worker/tick (Vercel Cron).
WORKER_TOKEN=""
# "true" (dev default) = agent runs execute inline. Production: "false" + worker.
WORKER_INLINE="true"
